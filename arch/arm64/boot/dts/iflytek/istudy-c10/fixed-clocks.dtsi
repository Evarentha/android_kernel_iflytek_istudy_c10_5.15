	rco_2m: rco-2m {
		compatible = "fixed-factor-clock";
		#clock-cells = <0x00>;
		clock-mult = <0x01>;
		clock-div = <0x32>;
		clocks = <0xdc>;
		clock-output-names = "rco-2m";
		phandle = <0x1aa>;
	};

